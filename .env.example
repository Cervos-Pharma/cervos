# ===========================================================================
#  CERVOS WEB - environment variables (single entry point)
# ===========================================================================
#
#  SETUP (3 steps)
#  ---------------
#    1. Copy this file to `.env.local`        <- `.env.local` is git-ignored
#         Windows PowerShell:   copy .env.example .env.local
#         macOS / Linux:        cp .env.example .env.local
#    2. Fill in every REQUIRED value below.
#    3. npm install && npm run dev
#
#  Verify before you start:      npm run check:env
#  Run with NO Supabase at all:  npm run dev:mock     (in-memory demo backend)
#
#  Rules:
#  - Never commit `.env.local` or `.env` - they are ignored in `.gitignore`.
#  - `NEXT_PUBLIC_*` values are INLINED AT BUILD TIME. Changing one requires
#    `npm run build` again; it will not update an already-running server.
#  - `HQ_SECRET` must be at least 32 characters and must not be a placeholder,
#    or HQ login silently rejects every attempt (see src/lib/hq-auth.ts).
#
#  The desktop/POS app has its OWN env file - see `cervos-desktop/.env.example`.
# ===========================================================================


# -- REQUIRED: Supabase -----------------------------------------------------
# Supabase dashboard -> Project Settings -> API
# "Project URL" and "anon public" key.

# Browser + server. Used by @supabase/ssr for all user-facing data access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. NEVER expose to the browser - this key bypasses Row Level
# Security entirely. Used for sync acknowledgements and HQ operations.
# Supabase dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET


# -- REQUIRED: HQ console & workspace session signing -----------------------
# Shared secret for the /hq back-office login. Generate a strong one:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   macOS/Linux: openssl rand -hex 32
# MUST be >= 32 chars and not contain the word "placeholder".
HQ_SECRET=REPLACE-WITH-AT-LEAST-32-CHARACTERS-0123456789

# Optional dedicated HMAC secret for /api/workspace/* cookies and mobile bearer
# tokens. If omitted, falls back to HQ_SECRET (min 24 chars).
WORKSPACE_SESSION_SECRET=


# -- REQUIRED: Deployment URL & CORS allowlist ------------------------------
# Canonical origin of the deployed site. Used for:
#   - `metadataBase` (Open Graph / social share URLs)
#   - Absolute links in sitemap.xml / Payme callback_url / CORS allowlist
NEXT_PUBLIC_APP_URL=https://cervos.online

# Optional comma-separated extra CORS origins (e.g. staging preview or custom domain).
# Wildcard `*` is rejected automatically.
CERVOS_ALLOWED_CORS_ORIGINS=


# -- OPTIONAL: Payment gateway (Payme Africa) -------------------------------
# Leave blank to run without payments - billing pages degrade gracefully.
# Payme merchant dashboard -> API credentials
PAYME_ENVIRONMENT=sandbox            # sandbox | production
PAYME_APP_ID=
PAYME_APP_SECRET=
PAYME_API_URL=


# -- OPTIONAL: Messaging & OTP (Textify Africa) -----------------------------
# Server-only secret. Never expose with NEXT_PUBLIC_.
TEXTIFY_API_KEY=
TEXTIFY_SENDER_NAME=CERVOS


# -- OPTIONAL: Notification Exceptions & HQ Trail Dispatch ------------------
# Optional webhook & alert inbox used when Cervos detects billing lock,
# critical FEFO write-off risk, or manual HQ overrides.
CERVOS_HQ_WEBHOOK_SECRET=
CERVOS_EXCEPTION_WEBHOOK_URL=
CERVOS_EXCEPTION_EMAIL=alerts@cervos.online
CERVOS_TRIAL_GRACE_DAYS=15


# -- OPTIONAL: Local development switches -----------------------------------
# true = serve the in-memory demo backend, no Supabase required.
# Set by `npm run dev:mock`; MUST be false (or unset) in production deploys.
NEXT_PUBLIC_MOCK_MODE=false
CERVOS_MOCK_AUTH=false


# -- REFERENCE: Expo React Native & EAS Build Secrets (configure in Expo/CI) -
# Do NOT put EXPO_TOKEN into the Next.js server runtime. Configure these in
# the Expo app `.env` or GitHub Actions / EAS Build secrets:
#   EXPO_PUBLIC_API_URL=https://cervos.online
#   EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
#   EXPO_TOKEN=your-expo-eas-ci-token
