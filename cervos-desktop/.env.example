# ═══════════════════════════════════════════════════════════════════════════
#  CERVOS ENDPOINT (desktop + Android APK) — environment variables
# ═══════════════════════════════════════════════════════════════════════════
#
#  This is the ONLY file you edit to configure the endpoint. The app builds
#  from `cervos-desktop/` and targets BOTH the desktop (Tauri) and the
#  Android APK (`npm run android:build`), so one env file covers both.
#
#  SETUP (3 steps)
#  ───────────────
#    1. Copy this file to `.env`        <- `.env` is git-ignored
#         Windows PowerShell:   copy .env.example .env
#         macOS / Linux:        cp .env.example .env
#    2. Fill in the two REQUIRED Supabase values.
#    3. npm install && npm run dev          (desktop)
#       npm run android:build              (APK)
#
#  ── Rules ──────────────────────────────────────────────────────────────────
#  • Vite inlines `VITE_*` values AT BUILD TIME. Editing this file does
#    nothing to an already-built binary — always rebuild.
#  • The web app has its OWN env file — see `../.env.example`. The values
#    are similar but not interchangeable: the web uses `NEXT_PUBLIC_*`.
#  • Never commit `.env`.
#
#  ── What happens without these ─────────────────────────────────────────────
#  The app still runs, but sync is disabled and the settings screen shows:
#    "POS not configured — Supabase keys missing. Rebuild the app with
#     VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY"
#  Data is then kept on-device only (workspace_mode = local).
# ═══════════════════════════════════════════════════════════════════════════


# ── REQUIRED · Supabase ─────────────────────────────────────────────────────
# Same project as the web app. Supabase dashboard → Project Settings → API.
# Must match `../.env.local` NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY exactly,
# otherwise the endpoint syncs to a different database than the web shows.
#
# The project used previously: https://jswmiwzkrttmxhnpcwrn.supabase.co

VITE_SUPABASE_URL=https://jswmiwzkrttmxhnpcwrn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard


# ── REQUIRED · Web origin ───────────────────────────────────────────────────
# Where this endpoint sends the pharmacist for billing, subscriptions and
# account management. Must be the deployed web app, not a stale localhost.

VITE_WEB_URL=https://cervos.online
# Fallback used if VITE_WEB_URL is unset.
VITE_APP_URL=https://cervos.online


# ── OPTIONAL · Local development ────────────────────────────────────────────
# Overrides the web origin ONLY when running `npm run dev` (Vite DEV=true).
# Defaults to http://localhost:3000 when unset.

VITE_DEV_WEB_URL=http://localhost:3000
