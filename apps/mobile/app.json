{
  "expo": {
    "name": "Cervos Pharma",
    "slug": "cervos-pharma",
    "scheme": "cervos",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cervos.pharma",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSCameraUsageDescription": "Scan medicine barcodes and QR labels for checkout and stock receiving.",
        "NSLocationWhenInUseUsageDescription": "Capture branch coordinates for supplier delivery estimates.",
        "NSFaceIDUsageDescription": "Unlock your staff station profile quickly with Face ID."
      }
    },
    "android": {
      "package": "com.cervos.pharma",
      "adaptiveIcon": {
        "backgroundColor": "#1039B9",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cervos Pharma to scan medicine barcodes and QR labels."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Cervos Pharma to unlock your station profile with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1039B9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "abd46a11-6524-48a6-9977-df4ca64140dc"
      }
    },
    "owner": "echeche"
  }
}
