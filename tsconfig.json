{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cervos/core": [
        "./packages/core/src/index.ts"
      ],
      "@cervos/db": [
        "./packages/db/src/index.ts"
      ],
      "@cervos/intelligence": [
        "./packages/intelligence/src/index.ts"
      ],
      "@cervos/ui": [
        "./packages/ui/src/index.tsx"
      ],
      "@cervos/i18n": [
        "./packages/i18n/src/index.ts"
      ],
      "@cervos/textify": [
        "./packages/textify/src/index.ts"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cervos-desktop",
    "cervos-supplier-desktop",
    "apps"
  ]
}
