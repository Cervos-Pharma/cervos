{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "typeRoots": ["./src/types", "../node_modules/@types"],
    "paths": {
      "@cervos/core": ["../packages/core/src/index.ts"],
      "@cervos/db": ["../packages/db/src/index.ts"],
      "@cervos/intelligence": ["../packages/intelligence/src/index.ts"],
      "@cervos/i18n": ["../packages/i18n/src/index.ts"],
      "@cervos/ui": ["../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
